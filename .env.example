# ARIA Configuration
ARIA_ENV=development
ARIA_DEBUG=true
ARIA_LOG_LEVEL=debug

# Kafka/Redpanda
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=aria-dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Qdrant (Vector DB)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# LLM Provider (Ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Path to Ollama models directory (default: ~/.ollama/models on Linux/macOS, E:/Programs/.ollama/models on Windows)
# OLLAMA_MODELS_PATH=E:/Programs/.ollama/models
OLLAMA_MODEL_BRAIN=aria-brain
OLLAMA_MODEL_BRAIN_PERSIAN=aria-persian-chat
OLLAMA_MODEL_EYE=aria-eye
OLLAMA_MODEL_CODER=aria-coder
OLLAMA_MODEL_AUDIO=aria-audio

# Embedding (sentence-transformers, NOT Ollama)
EMBEDDING_MODEL=PartAI/Tooka-SBERT-V2-Large
EMBEDDING_DIMS=1024

# STT (transformers, NOT Ollama)
VOICE_ENABLED=true
STT_MODEL=nezamisafa/whisper-persian-v4
STT_AUDIO_MODEL=Qwen2-Audio-7B-Instruct

# Optional: Cloud LLM
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# UI
UI_HOST=0.0.0.0
UI_PORT=8501
UI_THEME=light

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# WebSocket
WS_PING_INTERVAL=30
WS_MAX_CONNECTIONS=100

# CORS (development)
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# Job Apply
LINKEDIN_EMAIL=your-email@example.com
PROFILES_DIR=data/profiles
JOBS_DIR=data/jobs
APPLICATIONS_DIR=data/applications

# Learning
LEARNING_ENABLED=true
ARTIFACTS_DIR=data/artifacts
RECORDINGS_DIR=data/recordings
KAFKA_CONSUMER_GROUP_LEARNING=aria-learning

# Safety
SAFETY_ENABLED=true
SAFETY_STRICT_MODE=false
DOMAIN_ALLOWLIST_PATH=config/domains/allowlist.yaml
DOMAIN_DENYLIST_PATH=config/domains/denylist.yaml
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_SUBMIT=10/hour
RATE_LIMIT_APPLY=50/day
RATE_LIMIT_API_CALL=1000/hour
RATE_LIMIT_LOGIN=5/minute
PII_DETECTION_ENABLED=true
PII_LOG_REDACTION=true
PII_REDACT_IN_EVENTS=false
