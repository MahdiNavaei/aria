ARIA_ENV=test
ARIA_DEBUG=true
ARIA_LOG_LEVEL=debug

# Test Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=aria-test

# Test Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# Test LLM (can be mocked)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Disable features for faster tests
SCREENSHOT_STREAMING_ENABLED=false
LEARNING_ENABLED=false
